# Example Caddyfile Configuration for Funnel

funnel.example.com {
    # Automatic TLS via Let's Encrypt / ZeroSSL

    reverse_proxy 127.0.0.1:8000 {
        # Caddy automatically populates X-Forwarded-For, X-Forwarded-Proto, and client headers
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up Forwarded "for={remote_host};proto={scheme}"
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
